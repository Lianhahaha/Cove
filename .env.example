# Server-side only. Never prefix these with VITE_, or they'd be bundled into the app.

# Groq API key for the optional AI features (free tier: https://console.groq.com/keys).
GROQ_API_KEY=

# Set to "false" to switch every AI feature off without redeploying code.
AI_ENABLED=true

# Optional: override the model (must be in the allowlist in api/_lib/ai-guard.ts).
# AI_MODEL=llama-3.1-8b-instant

# Optional: comma-separated origins allowed to call /api/ai (defaults to the request's own host).
# ALLOWED_ORIGINS=https://cove.vercel.app
